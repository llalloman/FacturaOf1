TZ=America/Guayaquil
ENVIRONMENT=development

# PostgreSQL para n8n
POSTGRES_USER=facturaof1
POSTGRES_PASSWORD=change_me_secure
POSTGRES_DB=facturaof1_automation

# n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=change_me_32_chars_minimum_key

N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_admin_password

# OpenWA
OPENWA_PORT=8080
OPENWA_WEBHOOK_URL=http://n8n:5678/webhook/whatsapp-inbound

# FacturaOF1
FACTURAOF1_API_URL=https://facturaof1.of1solutions.com/api
FACTURAOF1_API_TOKEN=change_me
FACTURAOF1_SIGNATURE_FORM_URL=https://facturaof1.of1solutions.com/firma-electronica

# DeepSeek
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=change_me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

AI_ENABLE_MESSAGE_CLASSIFICATION=true
AI_ENABLE_RESPONSE_DRAFTING=true
AI_ENABLE_ORDER_SUMMARY=true
AI_ENABLE_PAYMENT_PROOF_READING=true
AI_ALLOW_CRITICAL_STATUS_CHANGE=false

# Correo
MAIL_FROM=firmas@of1solutions.com
MAIL_INTERNAL_TO=firmas@of1solutions.com
MAIL_INFO_TO=info@of1solutions.com

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change_me
SMTP_PASSWORD=change_me
SMTP_SECURE=false