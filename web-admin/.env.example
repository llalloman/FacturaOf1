# Activar solo si el producto requiere capacidades PWA.
VITE_ENABLE_PWA=false
VITE_FACTURAOF1_URL=http://localhost:5176
VITE_OF1_ADMIN_URL=http://localhost:5177
VITE_FIRMADOR_URL=http://localhost:5178
