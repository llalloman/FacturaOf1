{
  "name": "facturacion-sri-pos",
  "version": "1.0.0",
  "type": "module",
  "description": "Sistema de Facturación SRI Ecuador con POS Offline/Online",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "vite build",
    "build:electron": "electron-builder",
    "preview": "vite preview"
  },
  "keywords": [
    "facturacion",
    "sri",
    "pos",
    "electron",
    "offline"
  ],
  "author": "Tu Nombre",
  "license": "ISC",
  "dependencies": {
    "@tanstack/react-query": "^5.17.0",
    "@xmldom/xmldom": "^0.8.10",
    "axios": "^1.6.5",
    "better-sqlite3": "^9.2.2",
    "date-fns": "^3.0.6",
    "electron-store": "^8.1.0",
    "node-forge": "^1.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-keys": "^2.7.2",
    "react-router-dom": "^6.21.1",
    "react-to-print": "^2.15.1",
    "uuid": "^9.0.1",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.1.3",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^4.5.14",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.facturacion.sri",
    "productName": "Facturación SRI POS",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
