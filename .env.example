# Django Settings
# Genera una clave con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=reemplaza-con-clave-segura-aleatoria
DEBUG=False
ALLOWED_HOSTS=tu-app.railway.app,tudominio.com

# Database - Neon PostgreSQL
# Formato: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=postgresql://your_database_user:REMOVED_CREDENTIAL@your_database_host/neondb?sslmode=require

# O configuración separada (legacy):
DB_NAME=neondb
DB_USER=your_database_user
DB_PASSWORD=REMOVED_CREDENTIAL
DB_HOST=your_database_host
DB_PORT=5432
# Solo para el runner de pruebas; debe ser una base aislada de staging/local.
DJANGO_TEST_DB_NAME=facturaof1_staging_test

# Redis (Upstash - usar URL con rediss:// para SSL)
REDIS_URL=rediss://default:password@host:puerto

# CORS: URLs del frontend separadas por coma
CORS_ALLOWED_ORIGINS=https://tu-app.pages.dev,https://tudominio.com

# SRI Configuration (PRUEBAS o PRODUCCION)
SRI_AMBIENTE=PRODUCCION
SRI_PRUEBAS_RECEPCION_URL=https://celarium.sri.gob.ec/comprobantes-electronicos-ws/RecepcionComprobantesOffline?wsdl
SRI_PRUEBAS_AUTORIZACION_URL=https://celarium.sri.gob.ec/comprobantes-electronicos-ws/AutorizacionComprobantesOffline?wsdl
SRI_PRODUCCION_RECEPCION_URL=https://api.comprobanteselectronicos.gob.ec/comprobantes-electronicos-ws/RecepcionComprobantesOffline?wsdl
SRI_PRODUCCION_AUTORIZACION_URL=https://api.comprobanteselectronicos.gob.ec/comprobantes-electronicos-ws/AutorizacionComprobantesOffline?wsdl

# Email Configuration (para notificaciones)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
AUTOMATION_HANDOFF_NOTIFICATION_EMAIL=walter.molina@of1solutions.com
AUTOMATION_HUMAN_PENDING_TIMEOUT_MINUTES=10
AUTOMATION_HUMAN_ACTIVE_TIMEOUT_MINUTES=30
WHATSAPP_GATEWAY_URL=http://host.docker.internal:8081
WHATSAPP_GATEWAY_TOKEN=replace-with-shared-random-token
WHATSAPP_GATEWAY_TIMEOUT_SECONDS=10
AUTOMATION_API_TOKEN=change_me_to_a_long_random_secret

# Documentos de firma electrónica en S3 / Cloudflare R2
# Para local puedes dejar SIGNATURE_DOCUMENTS_STORAGE=local.
SIGNATURE_DOCUMENTS_STORAGE=s3
R2_ACCOUNT_ID=tu-account-id
R2_ACCESS_KEY_ID=tu-access-key
R2_SECRET_ACCESS_KEY=tu-secret-key
R2_BUCKET_NAME=tu-bucket
# Opcional. Úsalo solo si tienes dominio público/custom domain para el bucket.
R2_PUBLIC_URL=
# Alternativa compatible con S3. Si las defines, tienen prioridad sobre R2_*.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_S3_ADDRESSING_STYLE=path
AWS_QUERYSTRING_AUTH=True

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# Inventario: mantener true durante compatibilidad; usar false después de validar staging.
INVENTORY_ALLOW_NEGATIVE_STOCK=true
