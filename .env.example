# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database - Neon PostgreSQL
# Formato: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=postgresql://your_database_user:REMOVED_CREDENTIAL@your_database_host/neondb?sslmode=require

# O configuración separada (legacy):
DB_NAME=neondb
DB_USER=your_database_user
DB_PASSWORD=REMOVED_CREDENTIAL
DB_HOST=your_database_host
DB_PORT=5432

# Redis (Celery)
REDIS_URL=redis://localhost:6379/0

# SRI Configuration
SRI_AMBIENTE=PRUEBAS  # PRUEBAS o PRODUCCION
SRI_PRUEBAS_RECEPCION_URL=https://celarium.sri.gob.ec/comprobantes-electronicos-ws/RecepcionComprobantesOffline?wsdl
SRI_PRUEBAS_AUTORIZACION_URL=https://celarium.sri.gob.ec/comprobantes-electronicos-ws/AutorizacionComprobantesOffline?wsdl
SRI_PRODUCCION_RECEPCION_URL=https://api.comprobanteselectronicos.gob.ec/comprobantes-electronicos-ws/RecepcionComprobantesOffline?wsdl
SRI_PRODUCCION_AUTORIZACION_URL=https://api.comprobanteselectronicos.gob.ec/comprobantes-electronicos-ws/AutorizacionComprobantesOffline?wsdl

# Email Configuration (para notificaciones)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
